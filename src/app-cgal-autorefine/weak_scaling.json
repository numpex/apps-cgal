
{
    "bin_dir":"$PWD/build/default/src/app-cgal-autorefine/",
    "executable":"{{bin_dir}}/apps_cgal_autorefine",
    "use_case_name":"Structured_Grid_weak_scaling",
    "timeout":"0-0:10:0",
    "output_directory": "{{machine.output_app_dir}}/app-cgal-autorefine/{{use_case_name}}/{{instance}}",
    "options":[
        "--output-dirpath={{output_directory}}",
        "--triangles={{parameters.scaling_points.triangles.value}}",
        "--concurrency.max-threads={{parameters.scaling_points.max_workers.value}}"
    ],
    "scalability":{
        "directory":"{{output_directory}}",
        "stages":[
            {
                "name":"autorefine",
                "filepath":"timekeeper.json",
                "format":"json",
                "variables_path":["autorefine.times.*","autorefine.subsections.*.times.elapsed"]
            }
        ]
    },
    "resources":{
        "tasks":1,
        "exclusive_access":true
    },
    "parameters":[ {
        "name": "scaling_points", "zip": [
            { "name":"triangles", "sequence":[500, 707, 1000, 1414, 2000] },
            { "name":"max_workers", "sequence":[1,2,4,8,16] }
        ]
    } ]
}
