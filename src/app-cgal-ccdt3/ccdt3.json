{
    "bin_dir":"$PWD/build/default/src/app-cgal-ccdt3/",
    "executable":"{{bin_dir}}/apps_cgal_ccdt3",
    "use_case_name":"Structured_Grid",
    "timeout":"0-0:10:0",
    "output_directory": "{{machine.output_app_dir}}/app-cgal-ccdt3/{{use_case_name}}/{{instance}}",
    "options":[
        "--output-dirpath={{output_directory}}",
        "--cubes={{parameters.cubes.value}}"
        //"--concurrency.max-threads={{parameters.max_workers.value}}"
    ],
    "scalability":{
        "directory":"{{output_directory}}",
        "stages":[
            {
                "name":"ccdt3",
                "filepath":"timekeeper.json",
                "format":"json",
                "variables_path":["surfaceTetrahedralization.times.*"]
            }
        ]
    },
    "resources":{
        "tasks":1,
        "exclusive_access":true
    },
    "parameters":[
        //{ "name": "max_workers", "sequence":[1,2,4,8,16,32,64] },
        //{ "name": "max_workers", "sequence":[1,2,4,8] },
        //{ "name": "cubes", "sequence":[10,20,30] }
        { "name": "cubes", "sequence":[10,20,30] }
    ]
}
